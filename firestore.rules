rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'mda061638@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validPhoto() {
      return request.resource.data.keys().hasAll([
          'image', 'place', 'date', 'details', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'image', 'place', 'date', 'details', 'createdAt'
        ])
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 716800
        && request.resource.data.place is string
        && request.resource.data.place.size() > 0
        && request.resource.data.place.size() <= 150
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 2000
        && request.resource.data.createdAt is timestamp;
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create: if isOwner()
        && validPhoto()
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && validPhoto()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['image', 'place', 'date', 'details']);
      allow delete: if isOwner();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll([
            'name', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'name', 'text', 'createdAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 50
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update, delete: if isOwner();
      }
    }
  }
}
